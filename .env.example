# ---------------------------------------------------------------------------
# Argus environment template
# ---------------------------------------------------------------------------
# Usage:
# 1) Copy to .env
# 2) Fill values
# 3) Export in shell, or load via your process manager

# -----------------------------
# Config file path
# -----------------------------
# Optional. Defaults to /etc/argus/config.toml if unset.
ARGUS_CONFIG_PATH=""

# -----------------------------
# GitHub connector (required)
# -----------------------------
# From GitHub App settings -> "App ID"
GITHUB_APP_ID=""

# GitHub App webhook secret (must match app settings exactly)
GITHUB_WEBHOOK_SECRET=""

# Choose one private key mode:
# 1) Path mode (recommended): file path to downloaded GitHub App .pem
GITHUB_APP_PRIVATE_KEY_PATH=""
# 2) Inline mode: full PEM content (including BEGIN/END lines)
GITHUB_APP_PRIVATE_KEY_PEM=""

# SQLite state DB file for webhook idempotency/status
ARGUS_STATE_DB_PATH=""

# -----------------------------
# Argus core required (if not in TOML)
# -----------------------------
ARGUS_WIKI_ROOT=""
ARGUS_BOT_USERNAME=""

# -----------------------------
# Per-tier API keys (required unless set in TOML)
# -----------------------------
ARGUS_FAST_API_KEY=""
ARGUS_STANDARD_API_KEY=""
ARGUS_DEEP_API_KEY=""

# -----------------------------
# Per-tier provider/model overrides (optional if set in TOML)
# Providers: anthropic | ollama | openrouter
# -----------------------------
ARGUS_FAST_PROVIDER=""
ARGUS_STANDARD_PROVIDER=""
ARGUS_DEEP_PROVIDER=""

ARGUS_FAST_MODEL=""
ARGUS_STANDARD_MODEL=""
ARGUS_DEEP_MODEL=""

# -----------------------------
# Optional runtime behavior
# -----------------------------
ARGUS_REVIEW_DRAFTS=""
ARGUS_ACKNOWLEDGE_EVENTS=""
ARGUS_VERDICT_THRESHOLD=""

# -----------------------------
# Optional limits/tuning
# -----------------------------
ARGUS_MAX_PLANS=""
ARGUS_MAX_INLINE_SUGGESTIONS=""
ARGUS_MAX_SEARCH_RESULTS=""
ARGUS_MAX_FILE_WINDOW_LINES=""
ARGUS_THREAD_COMPACT_THRESHOLD=""
ARGUS_PRELOAD_DIFF_THRESHOLD=""

# -----------------------------
# OpenRouter (when provider=openrouter)
# -----------------------------
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_APP_NAME=""
OPENROUTER_APP_URL=""

# -----------------------------
# Ollama (when provider=ollama)
# -----------------------------
ARGUS_OLLAMA_HOST="http://localhost:11434"
